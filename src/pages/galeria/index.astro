---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildImageUrl } from '../../lib/contentful-image';
import { getAllGalleries } from '../../lib/contentful';

const galleries = await getAllGalleries();
---

<BaseLayout title="Galeria">
  <header class="page-header">
    <h1>Galeria</h1>
  </header>
  <section>
    {
      galleries.map((gallery) => (
        <article class="gallery-card">
          <a href={`/galeria/${gallery.slug}`}>
            {gallery.coverImage && (
              <img
                src={buildImageUrl(gallery.coverImage.url, { width: 800 })}
                alt={gallery.coverImage.alt}
                width={gallery.coverImage.width}
                height={gallery.coverImage.height}
                loading="lazy"
              />
            )}
          </a>
          <h2>
            <a href={`/galeria/${gallery.slug}`}>{gallery.title}</a>
          </h2>
          {gallery.description && <p class="excerpt">{gallery.description}</p>}
        </article>
      ))
    }
    {galleries.length === 0 && <p>Brak galerii.</p>}
  </section>
</BaseLayout>
